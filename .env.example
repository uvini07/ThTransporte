# true  = modo demonstração: campos sem dados aparecem como "A informar" e
#         itens não confirmados exibem o selo "A confirmar". A página recebe noindex.
# false = versão pública: campos vazios e itens não confirmados ficam ocultos.
VITE_DEMO_MODE=false

# Endpoint que recebe o formulário de orçamento via POST (JSON).
# Compatível com Formspree (https://formspree.io/f/XXXX), Getform, Basin,
# ou um backend próprio. Deixe vazio para manter o formulário em modo demonstração.
VITE_FORM_ENDPOINT=
